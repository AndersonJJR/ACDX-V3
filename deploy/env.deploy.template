# ERP Brazil - Environment Variables Template
# Copy this file to .env and fill in the values
# For production, use docker-compose -f deploy/docker-compose.prod.yml --env-file .env up -d

# ============================================
# Application Configuration
# ============================================
# Spring Profiles: dev, prod, test
SPRING_PROFILES_ACTIVE=dev

# Application Version
APP_VERSION=1.0.0-SNAPSHOT

# Server Ports
API_GATEWAY_PORT=8080
IDENTITY_SERVICE_PORT=8081
FINANCE_SERVICE_PORT=8082
FISCAL_SERVICE_PORT=8083
HR_SERVICE_PORT=8084
INVENTORY_SERVICE_PORT=8085
MANUFACTURING_SERVICE_PORT=8086
SALES_SERVICE_PORT=8087

# ============================================
# Database - MySQL 8.4
# ============================================
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=erp_dev
MYSQL_USER=erp_user
MYSQL_PASSWORD=erp_password
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_MAX_POOL_SIZE=20
MYSQL_MIN_IDLE=5

# Identity Service Database
IDENTITY_MYSQL_DATABASE=identity_dev

# Finance Service Database
FINANCE_MYSQL_DATABASE=finance_dev

# Fiscal Service Database
FISCAL_MYSQL_DATABASE=fiscal_dev

# HR Service Database
HR_MYSQL_DATABASE=hr_dev

# Inventory Service Database
INVENTORY_MYSQL_DATABASE=inventory_dev

# Manufacturing Service Database
MANUFACTURING_MYSQL_DATABASE=manufacturing_dev

# Sales Service Database
SALES_MYSQL_DATABASE=sales_dev

# ============================================
# Database - MongoDB 7.0
# ============================================
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DATABASE=erp_dev
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=adminpassword
MONGO_URI=mongodb://admin:adminpassword@mongodb:27017/erp_dev?authSource=admin

# ============================================
# Cache - Redis 7
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false
REDIS_MAX_ACTIVE=20
REDIS_MAX_IDLE=10
REDIS_MIN_IDLE=5

# ============================================
# Message Broker - RabbitMQ 3.13
# ============================================
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=erp_user
RABBITMQ_PASSWORD=erp_password
RABBITMQ_VHOST=/erp
RABBITMQ_CONCURRENCY=5
RABBITMQ_MAX_CONCURRENCY=20
RABBITMQ_PREFETCH=20

# ============================================
# JWT Security
# ============================================
# Generate with: openssl rand -base64 64
JWT_SECRET=change-this-secret-in-production-min-256-bits-change-this-secret-in-production
JWT_ACCESS_TOKEN_VALIDITY=3600
JWT_REFRESH_TOKEN_VALIDITY=604800
JWT_ISSUER=erp-brazil
JWT_JWK_SET_URI=https://auth.erp.brazil.com/.well-known/jwks.json
JWT_ISSUER_URI=https://auth.erp.brazil.com

# ============================================
# CORS Configuration
# ============================================
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000,http://localhost:8080
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=*
CORS_EXPOSED_HEADERS=X-Tenant-ID,X-Request-ID,X-User-ID
CORS_MAX_AGE=3600

# ============================================
# Event Configuration
# ============================================
EVENTS_EXCHANGE=erp.events
EVENTS_ROUTING_KEY_PREFIX=erp

# ============================================
# Outbox Configuration
# ============================================
OUTBOX_BATCH_SIZE=100
OUTBOX_POLL_INTERVAL=5000

# ============================================
# OpenAPI Configuration
# ============================================
OPENAPI_TITLE=ERP Brazil API
OPENAPI_VERSION=1.0.0
OPENAPI_DESCRIPTION=ERP Brazil Microservices API
OPENAPI_DEV_URL=http://localhost:8080
OPENAPI_PROD_URL=https://api.erp.brazil.com

# ============================================
# Distributed Lock Configuration
# ============================================
LOCK_DEFAULT_WAIT_TIME=10
LOCK_DEFAULT_LEASE_TIME=30

# ============================================
# Config Server (Optional)
# ============================================
CONFIG_SERVER_URL=http://config-server:8888

# ============================================
# Tool Credentials (Development)
# ============================================
# pgAdmin
PGADMIN_EMAIL=admin@erp.brazil.com
PGADMIN_PASSWORD=adminpassword

# Mongo Express
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=adminpassword

# Redis Commander
REDIS_CMD_USER=admin
REDIS_CMD_PASSWORD=adminpassword

# ============================================
# Monitoring & Observability
# ============================================
# Prometheus
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=adminpassword

# Jaeger (Tracing)
JAEGER_HOST=jaeger
JAEGER_PORT=6831

# ============================================
# Email Configuration (Optional)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=noreply@erp.brazil.com
SMTP_PASSWORD=
SMTP_FROM=noreply@erp.brazil.com

# ============================================
# File Storage (Optional - MinIO/S3)
# ============================================
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=erp-files
MINIO_REGION=us-east-1

# ============================================
# Feature Flags
# ============================================
FEATURE_MULTI_TENANT=true
FEATURE_AUDIT_LOG=true
FEATURE_OUTBOX_PATTERN=true
FEATURE_DISTRIBUTED_LOCK=true
FEATURE_RATE_LIMITING=true
FEATURE_CIRCUIT_BREAKER=true

# ============================================
# Logging
# ============================================
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_COM_ERP_BRAZIL=DEBUG
LOG_FILE_PATH=/var/log/erp

# ============================================
# Production Overrides (uncomment for production)
# ============================================
# SPRING_PROFILES_ACTIVE=prod
# MYSQL_HOST=mysql-prod
# MYSQL_PASSWORD=secure-production-password
# MONGO_ROOT_PASSWORD=secure-mongo-password
# REDIS_PASSWORD=secure-redis-password
# RABBITMQ_PASSWORD=secure-rabbitmq-password
# JWT_SECRET=your-256-bit-production-secret-here
# CORS_ALLOWED_ORIGINS=https://erp.brazil.com,https://admin.erp.brazil.com
# LOG_LEVEL_ROOT=WARN
# LOG_LEVEL_COM_ERP_BRAZIL=INFO