# ===========================================
# ERP BRAZIL - DEPLOYMENT ENVIRONMENT TEMPLATE
# Copy this file to .env and fill in the values
# ===========================================

# -------------------------------------------
# GENERAL SETTINGS
# -------------------------------------------
SPRING_PROFILE=dev
FRONTEND_URL=http://localhost:4200

# -------------------------------------------
# DATABASE - MYSQL 8.4
# -------------------------------------------
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=erp_brazil
MYSQL_USER=erp_user
MYSQL_PASSWORD=erppass
MYSQL_PORT=3306

# -------------------------------------------
# DATABASE - MONGODB 7.0
# -------------------------------------------
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=mongopass
MONGO_DATABASE=erp_brazil
MONGO_PORT=27017

# -------------------------------------------
# REDIS 7
# -------------------------------------------
REDIS_PASSWORD=redispass
REDIS_PORT=6379

# -------------------------------------------
# RABBITMQ 3.13
# -------------------------------------------
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MGMT_PORT=15672

# -------------------------------------------
# JWT SECURITY (CRITICAL - CHANGE IN PRODUCTION!)
# -------------------------------------------
JWT_SECRET=change-this-secret-in-production-min-256-bits-change-this-secret-in-production
JWT_ISSUER=erp-brazil
JWT_ACCESS_TOKEN_VALIDITY_SECONDS=3600
JWT_REFRESH_TOKEN_VALIDITY_SECONDS=604800

# -------------------------------------------
# MICROSERVICE PORTS
# -------------------------------------------
GATEWAY_PORT=8080
IDENTITY_PORT=8081
FINANCE_PORT=8082
FISCAL_PORT=8083
HR_PORT=8084
INVENTORY_PORT=8085
MANUFACTURING_PORT=8086
SALES_PORT=8087
FRONTEND_PORT=4200

# -------------------------------------------
# ADMIN UI PORTS (Development Only)
# -------------------------------------------
PHPMYADMIN_PORT=8080
MONGO_EXPRESS_PORT=8081
REDIS_COMMANDER_PORT=8082

# -------------------------------------------
# SPRING CLOUD / SERVICE DISCOVERY
# -------------------------------------------
CONFIG_SERVER_URI=
EUREKA_URI=

# -------------------------------------------
# EMAIL / SMTP
# -------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@erp.brazil.com

# -------------------------------------------
# CERTIFICADO DIGITAL A1 (NF-e/NFC-e)
# -------------------------------------------
CERTIFICADO_A1_PATH=/certs/certificado.pfx
CERTIFICADO_A1_PASSWORD=
SEFAZ_ENVIRONMENT=homologacao
SEFAZ_UF=SP

# -------------------------------------------
# WHATSAPP BUSINESS API
# -------------------------------------------
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# -------------------------------------------
# EXTERNAL INTEGRATIONS
# -------------------------------------------
VIA_CEP_API_URL=https://viacep.com.br/ws
IBGE_API_URL=https://servicodados.ibge.gov.br/api/v1
CORREIOS_API_URL=
CORREIOS_USER=
CORREIOS_PASSWORD=

# -------------------------------------------
# MONITORING / OBSERVABILITY
# -------------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
JAEGER_PORT=16686
ZIPKIN_PORT=9411

# -------------------------------------------
# LOGGING
# -------------------------------------------
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_COM_ERP_BRASIL=DEBUG
LOG_FILE_PATH=/var/log/erp-brazil

# -------------------------------------------
# FEATURE FLAGS
# -------------------------------------------
FEATURE_SCHEDULER_ENABLED=true
FEATURE_AUDIT_ENABLED=true
FEATURE_WEBHOOK_ENABLED=true
FEATURE_REPORT_GENERATION_ENABLED=true

# -------------------------------------------
# PRODUCTION OVERRIDES (Uncomment for production)
# -------------------------------------------
# SPRING_PROFILE=prod
# MYSQL_ROOT_PASSWORD=<strong-random-password>
# MYSQL_PASSWORD=<strong-random-password>
# MONGO_ROOT_PASSWORD=<strong-random-password>
# REDIS_PASSWORD=<strong-random-password>
# RABBITMQ_PASSWORD=<strong-random-password>
# JWT_SECRET=<256-bit-random-secret>
# SEFAZ_ENVIRONMENT=producao
# FRONTEND_URL=https://erp.brazil.com
# MAIL_HOST=smtp.sendgrid.net
# MAIL_PORT=587
# MAIL_USERNAME=apikey
# MAIL_PASSWORD=<sendgrid-api-key>
# LOG_LEVEL_ROOT=WARN
# LOG_LEVEL_COM_ERP_BRASIL=INFO

# -------------------------------------------
# DOCKER SECRETS (Production - files in /run/secrets/)
# -------------------------------------------
# mysql_root_password
# mysql_password
# mongo_root_user
# mongo_root_password
# redis_password
# rabbitmq_user
# rabbitmq_password
# jwt_secret
# certificado_a1_password
# mail_username
# mail_password

# -------------------------------------------
# KUBERNETES / HELM (Optional)
# -------------------------------------------
# K8S_NAMESPACE=erp-brazil
# HELM_RELEASE=erp-brazil
# INGRESS_CLASS=nginx
# TLS_SECRET=erp-brazil-tls